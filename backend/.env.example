# Copy these into your shell or IDE run configuration. Never commit real values.
SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://localhost:3306/hprrims?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hprrims
DB_PASSWORD=change-me
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173
ML_SERVICE_URL=http://localhost:8001
# Must match ML_SERVICE_API_KEY in ml-service/.env when set
ML_SERVICE_API_KEY=
SERVER_PORT=8080
